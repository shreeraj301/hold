# OAuth client secrets for the Grok auth broker. Nothing here is a default.
# The app reads process.env. An empty value is treated as unset.
#
# GROK_AUTH_CLIENT_SECRET is the per-app secret injected on deploy. It wins
# when set. GROK_PREVIEW_CLIENT_SECRET is the shared live-preview client,
# used only when the per-app secret is absent.
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=
